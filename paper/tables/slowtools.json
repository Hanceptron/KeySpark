      "default_interval_s": 300,
      "randomisation": "fixed period (JiggleTime default 5 minutes; JiggleSeconds minimum 5 s); by default jiggles only after that much idle time",
      "event_types": [
        "move (absolute, CGEventPost at kCGHIDEventTap)",
        "click down/up with the click style",
        "none with the Zen style (IOPMAssertion only)"
      ],
      "geometry": "standard style (default): 35 moves scheduled 10 ms apart, each the current position plus a uniform integer offset of up to JiggleDistance^2 + 10 = 14 px per axis (default distance 2), kept within 28 px of the last user position",
